{
    "name": "dissnik/robots-txt",
    "description": "robots.txt management for Laravel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "DissNik",
            "homepage": "https://github.com/DissNik",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "DissNik\\RobotsTxt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DissNik\\RobotsTxt\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DissNik\\RobotsTxt\\Providers\\RobotsTxtServiceProvider"
            ],
            "aliases": {
                "RobotsTxt": "DissNik\\RobotsTxt\\Facades\\RobotsTxt"
            }
        }
    },
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0"
    },
    "require-dev": {
        "laravel/laravel": "^12.11",
        "larastan/larastan": "^3.0",
        "phpunit/phpunit": "^12.5",
        "orchestra/testbench": "^10.8",
        "rector/rector": "^2.2",
        "laravel/pint": "^1.26"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "analyse": "vendor/bin/phpstan analyse",
        "lint": "vendor/bin/pint --test",
        "lint-fix": "vendor/bin/pint -v",
        "rector": "vendor/bin/rector",
        "rector-dry-run": "vendor/bin/rector process --dry-run",
        "rector-fix": "vendor/bin/rector process --ansi",
        "qa": [
            "@lint",
            "@analyse",
            "@rector-dry-run",
            "@test"
        ],
        "fix": [
            "@lint-fix",
            "@rector-fix"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
