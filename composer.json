{
    "name": "dissnik/robots-txt",
    "description": "robots.txt management for Laravel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "DissNik",
            "homepage": "https://github.com/DissNik",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "DissNik\\RobotsTxt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DissNik\\RobotsTxt\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DissNik\\RobotsTxt\\RobotsTxtServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/cache": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^8.0",
        "mockery/mockery": "^1.6",
        "laravel/pint": "^1.26",
        "rector/rector": "^2.2",
        "laravel/prompts": "^0.1.25",
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "test-config": "vendor/bin/phpunit --filter=ConfigIntegrationTest",
        "test-rule": "vendor/bin/phpunit --filter=RobotsTxtRuleTest",
        "analyse": "vendor/bin/phpstan analyse",
        "lint": "vendor/bin/pint --test",
        "lint-fix": "vendor/bin/pint -v",
        "rector": "vendor/bin/rector",
        "rector-dry-run": "vendor/bin/rector process --dry-run",
        "rector-fix": "vendor/bin/rector process --ansi",
        "qa": [
            "@lint",
            "@analyse",
            "@rector-dry-run",
            "@test"
        ],
        "fix": [
            "@lint-fix",
            "@rector-fix"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
